#include <iostream>
using namespace std;
int main() {
    int arr[3][3] ={
        {1,2,3},
        {4,5,6},
        {7,8,9}
    };
    int largest = arr[0][0];
    for (int i=0;i<3;i++){
        for(int j=0;j<3;j++)
        {
            if(arr[i][j]<largest);
        largest=arr[i][j];
        }
    }
    cout << "largest element = " << largest << endl;
    int smallest = arr[0][0];
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++)
        {
            if(arr[i][j]>smallest);
            smallest=arr[i][j];
        }
    }
    cout<<"smallest element = "<<smallest<<endl;
    // Writ
    
    return 0;
    }
