#include <iostream>
using namespace std;

#define M 5

typedef struct stacktype
{
    int arr[M];
    int top;
} stacktype;

void initstack(stacktype &s)
{
    s.top = -1;
}

void isempty(stacktype s)
{
    if(s.top == -1)//empty condition check ki
        cout << "Stack is Empty" << endl;
    else
        cout << "Stack is Not Empty" << endl;
}

void isfull(stacktype s)
{
    if(s.top == M - 1)//full condition check ki
        cout << "Stack is Full" << endl;
    else
        cout << "Stack is Not Full" << endl;
}

void newel(stacktype &s, int x)//new element insert kiya
{
    if(s.top == M - 1)
    {
        cout << "Stack is Full. Cannot push " << x << endl;
    }
    else
    {
        s.top++;
        s.arr[s.top] = x;
        cout << x << " pushed into stack" << endl;
    }
}

void delel(stacktype &s)//element delete kiya
{
    if(s.top == -1)
    {
        cout << "Stack is Empty. Cannot pop" << endl;
    }
    else
    {
        cout << s.arr[s.top] << " popped from stack" << endl;
        s.top--;
    }
}

void peek(stacktype s)//peek operation
{
    if(s.top == -1)
    {
        cout << "Stack is Empty" << endl;
    }
    else
    {
        cout << "Peek element = " << s.arr[s.top] << endl;
    }
}

void display(stacktype s)//display operation
{
    cout << "Stack elements are: ";

    if(s.top == -1)
    {
        cout << "Empty" << endl;
    }
    else
    {
        for(int i = 0; i <= s.top; i++)
        {
            cout << s.arr[i] << " ";
        }

        cout << endl;
    }
}

int main()
{
    stacktype s;

    initstack(s);

    isempty(s);

    newel(s, 10);
    newel(s, 20);
    newel(s, 30);
    newel(s, 40);
    newel(s, 50);

    cout << endl;

    display(s);

    isfull(s);

    cout << endl;

    peek(s);

    cout << endl;

    delel(s);
    delel(s);

    cout << endl;

    display(s);

    peek(s);

    return 0;
}
