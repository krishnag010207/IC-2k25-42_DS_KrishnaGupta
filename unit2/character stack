#include <iostream>
using namespace std;

#define M 5

typedef struct stacktype
{
    char arr[M];
    int top;
} stacktype;

void initstack(stacktype &s)//inititaliztaion
{
    s.top = -1;
}

void newel(stacktype &s, char x)//insertion
{
    if(s.top == M - 1)
    {
        cout << "Stack is Full" << endl;
    }
    else
    {
        s.top++;
        s.arr[s.top] = x;
    }
}

void peek(stacktype s)//peek operation
{
    if(s.top == -1)//check if stack is empty
    {
        cout << "Stack is Empty" << endl;
    }
    else
    {
        cout << "Peek element = " << s.arr[s.top] << endl;
    }
}

void display(stacktype s)//display operation
{
    cout << "Stack elements are: ";

    if(s.top == -1)
    {
        cout << "Empty" << endl;
    }
    else
    {
        for(int i = 0; i <= s.top; i++)
        {
            cout << s.arr[i] << " ";
        }

        cout << endl;
    }
}

int main()
{
    stacktype s;

    initstack(s);

    newel(s, 'A');
    newel(s, 'B');
    newel(s, 'C');
    newel(s, 'D');
    newel(s, 'E');

    display(s);

    peek(s);

    return 0;
}
