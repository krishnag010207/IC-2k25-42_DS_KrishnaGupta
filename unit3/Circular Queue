#include <iostream>
using namespace std;

#define M 5

typedef struct queuetype
{
    int arr[M];
    int front;
    int rear;
} queuetype;

void initqueue(queuetype &q)
{
    q.front = -1;
    q.rear = -1;
}

void isempty(queuetype q)
{
    if(q.front == -1)
        cout << "Queue is Empty" << endl;
    else
        cout << "Queue is Not Empty" << endl;
}

void isfull(queuetype q)
{
    if((q.rear + 1) % M == q.front)
        cout << "Queue is Full" << endl;
    else
        cout << "Queue is Not Full" << endl;
}

void newel(queuetype &q, int x)
{
    if((q.rear + 1) % M == q.front)
    {
        cout << "Queue is Full. Cannot insert " << x << endl;
    }
    else
    {
        if(q.front == -1)
        {
            q.front = 0;
            q.rear = 0;
        }
        else
        {
            q.rear = (q.rear + 1) % M;
        }

        q.arr[q.rear] = x;

        cout << x << " inserted into queue" << endl;
    }
}

void delel(queuetype &q)
{
    if(q.front == -1)
    {
        cout << "Queue is Empty. Cannot delete" << endl;
    }
    else
    {
        cout << q.arr[q.front] << " deleted from queue" << endl;

        if(q.front == q.rear)
        {
            q.front = -1;
            q.rear = -1;
        }
        else
        {
            q.front = (q.front + 1) % M;
        }
    }
}

void display(queuetype q)
{
    if(q.front == -1)
    {
        cout << "Queue is Empty" << endl;
    }
    else
    {
        cout << "Queue elements are: ";

        int i = q.front;

        while(true)
        {
            cout << q.arr[i] << " ";

            if(i == q.rear)
                break;

            i = (i + 1) % M;
        }

        cout << endl;
    }
}

int main()
{
    queuetype q;

    initqueue(q);

    isempty(q);

    newel(q, 10);
    newel(q, 20);
    newel(q, 30);
    newel(q, 40);
    newel(q, 50);

    cout << endl;

    display(q);

    isfull(q);

    cout << endl;

    delel(q);
    delel(q);

    cout << endl;

    display(q);

    cout << endl;

    newel(q, 60);
    newel(q, 70);

    cout << endl;

    display(q);

    isfull(q);

    return 0;
}
