#include <iostream>
using namespace std;

#define M 5

typedef struct queuetype//define the quue
{
    int arr[M];
    int front;
    int rear;
} queuetype;

void initqueue(queuetype &q)//initialization
{
    q.front = -1;
    q.rear = -1;
}

void isempty(queuetype q)//check if queue in empty
{
    if(q.front == -1)
        cout << "Queue is Empty" << endl;
    else
        cout << "Queue is Not Empty" << endl;
}

void isfull(queuetype q)//chek if queue is full
{
    if(q.rear == M - 1)
        cout << "Queue is Full" << endl;
    else
        cout << "Queue is Not Full" << endl;
}

void newel(queuetype &q, int x)//insertion
{
    if(q.rear == M - 1)
    {
        cout << "Queue is Full. Cannot insert " << x << endl;
    }
    else
    {
        if(q.front == -1)
            q.front = 0;

        q.rear++;
        q.arr[q.rear] = x;

        cout << x << " inserted into queue" << endl;
    }
}

void delel(queuetype &q)//deletion
{
    if(q.front == -1 || q.front > q.rear)
    {
        cout << "Queue is Empty. Cannot delete" << endl;
    }
    else
    {
        cout << q.arr[q.front] << " deleted from queue" << endl;
        q.front++;

        if(q.front > q.rear)
        {
            q.front = -1;
            q.rear = -1;
        }
    }
}

void display(queuetype q)//display operation
{
    if(q.front == -1)
    {
        cout << "Queue is Empty" << endl;
    }
    else
    {
        cout << "Queue elements are: ";

        for(int i = q.front; i <= q.rear; i++)
        {
            cout << q.arr[i] << " ";
        }

        cout << endl;
    }
}

int main()
{
    queuetype q;

    initqueue(q);

    isempty(q);

    newel(q, 10);
    newel(q, 20);
    newel(q, 30);
    newel(q, 40);
    newel(q, 50);

    cout << endl;

    display(q);

    isfull(q);

    cout << endl;

    delel(q);
    delel(q);

    cout << endl;

    display(q);

    isempty(q);

    return 0;
}
